#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include "keys.h"

&mt {
        tapping-term-ms = <150>;
        quick-tap-ms = <150>;
};

&lt {
        tapping-term-ms = <150>;
        quick-tap-ms = <150>;
        flavor = "hold-preferred";
};

/ {
        behaviors {
                comma_excl: comma_excl {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DV_COMMA>, <&kp EXCL>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                dot_qmark: dot_qmark {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DV_DOT>, <&kp DV_QMARK>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };

                fslh_bslh: fslh_bslh {
                        compatible = "zmk,behavior-mod-morph";
                        #binding-cells = <0>;
                        bindings = <&kp DV_FSLH>, <&kp BSLH>;
                        mods = <(MOD_LSFT|MOD_RSFT)>;
                };
        };

        macros {
                dotdot_slash: dotdot_slash {
                        compatible = "zmk,behavior-macro";
                        #binding-cells = <0>;
                        bindings = <&kp DV_DOT &kp DV_DOT &kp DV_FSLH>;
                };
        };

        combos {
                compatible = "zmk,combos";
                combo_dotdot_slash {
                        timeout-ms = <50>;
                        key-positions = <3 11>;
                        bindings = <&dotdot_slash>;
                };
        };

        keymap {
                compatible = "zmk,keymap";

                default_layer {
// ---------------------------------------------------------------------------------------------------------
// |   TAB   |   '   |   ,   |   .   |   P   |   Y   |   |   F   |   G   |   C   |   R   |   L   |    /    |
// | ESC/CTL |   A   |   O   |   E   |   U   |   I   |   |   D   |   H   |   T   |   N   |   S   |    -    |
// |  SHIFT  |   ;   |   Q   |   J   |   K   |   X   |   |   B   |   M   |   W   |   V   |   Z   | BSP/SFT |
//                           |  GUI  |DEL/LWR|  SPC  |   |  ENT  |BSP/RSE|  ALT  |
                        display-name = "Base";
                        bindings = <
   &kp TAB    &kp DV_SQT  &comma_excl &dot_qmark &kp DV_P &kp DV_Y  &kp DV_F   &kp DV_G  &kp DV_C &kp DV_R &kp DV_L &fslh_bslh
&mt LCTRL ESC &kp DV_A    &kp DV_O    &kp DV_E   &kp DV_U  &kp DV_I  &kp DV_D   &kp DV_H  &kp DV_T &kp DV_N &kp DV_S &kp DV_MINUS
   &kp LSHFT  &kp DV_SEMI &kp DV_Q    &kp DV_J   &kp DV_K  &kp DV_X  &kp DV_B   &kp DV_M  &kp DV_W &kp DV_V &kp DV_Z &mt RSHFT BSPC
                          &kp LGUI    &lt 1 DEL  &kp SPACE &kp RET   &lt 2 BSPC &kp RALT
                        >;
                };
                lower_layer {
// ---------------------------------------------------------------------------------------------------------
// |         | VOL+  | HOME  |  UP   | PGUP  |  CUT  |   |   ~   |   7   |   8   |   9   |   +   |    /    |
// |         | VOL-  | LEFT  | DOWN  | RGHT  | COPY  |   | PIPE  |   4   |   5   |   6   |   =   |    -    |
// |         | MUTE  |  END  |  F3   | PGDN  | PASTE |   |   &   |   1   |   2   |   3   |   *   |         |
//                           |       |       |       |   |  ENT  |   0   |   .   |
                        display-name = "Lower";
                        bindings = <
   &trans &kp K_VOL_UP &kp HOME &kp UP    &kp PG_UP &kp K_CUT    &kp TILDE &kp N7  &kp N8  &kp N9 &kp KP_PLUS     &kp KP_SLASH
   &trans &kp K_VOL_DN &kp LEFT &kp DOWN  &kp RIGHT &kp K_COPY   &kp PIPE  &kp N4  &kp N5  &kp N6 &kp KP_EQUAL    &kp KP_MINUS
   &trans &kp K_MUTE   &kp END  &kp F3    &kp PG_DN &kp K_PASTE  &kp AMPS  &kp N1  &kp N2  &kp N3 &kp KP_ASTERISK &trans
                       &trans   &trans    &trans    &kp KP_ENTER &kp N0    &kp KP_DOT
                        >;
                };

                raise_layer {
// ---------------------------------------------------------------------------------------------------------
// |         |   `   |   @   |   [   |   ]   |   ^   |   | PSCR  |  F1   |  F2   |  F3   |  F4   |         |
// |         |   #   |   *   |   (   |   )   |   $   |   | PGUP  |  F5   |  F6   |  F7   |  F8   |         |
// |         |   <   |   >   |   {   |   }   |   %   |   | PGDN  |  F9   |  F10  |  F11  |  F12  |         |
//                           |       |       |       |   |       |       |       |
                        display-name = "Raise";
                        bindings = <
   &trans &kp GRAVE &kp AT    &kp DV_LBKT &kp DV_RBKT &kp CARET  &kp PSCRN &kp F1  &kp F2  &kp F3  &kp F4  &trans
   &trans &kp HASH  &kp STAR  &kp LPAR    &kp RPAR    &kp DLLR   &kp PG_UP &kp F5  &kp F6  &kp F7  &kp F8  &trans
   &trans &kp DV_LT &kp DV_GT &kp DV_LBRC &kp DV_RBRC &kp PRCNT  &kp PG_DN &kp F9  &kp F10 &kp F11 &kp F12 &trans
                    	     &trans   &trans   &trans     &trans    &trans  &trans
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
